<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Fornecedores</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head><body>
<%- include('../partials/nav') %><div class="container mt-4"><div class="card shadow-sm mb-4"><div class="card-body"><h5 class="mb-3">➕ Novo Fornecedor</h5><form action="/fornecedores/salvar" method="POST"><div class="mb-3"><label class="form-label">Nome</label><input type="text" name="nome" class="form-control" required></div><div class="mb-3"><label class="form-label">CNPJ</label><input type="text" name="cnpj" class="form-control" placeholder="00.000.000/0000-00" required></div><button class="btn btn-primary">Salvar</button></form></div></div><h4>🏢 Fornecedores</h4><div class="table-responsive"><table class="table table-bordered table-hover"><thead class="table-dark"><tr><th>ID</th><th>Nome</th><th>CNPJ</th></tr></thead><tbody><% fornecedores.forEach(f => { %><tr><td><%= f.id %></td><td><%= f.nome %></td><td><%= f.cnpj %></td></tr><% }) %></tbody></table></div><a href="/" class="btn btn-secondary w-100">Voltar</a></div><%- include('../partials/footer') %></body></html>
